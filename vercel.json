{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "parent_notifier/wsgi.py": {
      "excludeFiles": "{tests/**,samples/**,scripts/**,public/**,.github/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}

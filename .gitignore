# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Test and lint output
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
playwright-report/
test-results/

# Runtime data: database, secrets, staged imports, logs
instance/
*.db
*.sqlite3
*.log
.env

# Keys and certificates
*.pem
*.key
*.p12

# Local documents; README.md is the only tracked document
CHANGELOG.md
CONTRIBUTING.md
docs/

# GitHub: only the Actions workflows are tracked
.github/*
!.github/workflows/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
